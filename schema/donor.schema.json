{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://crm.local/schema/donor.schema.json",
  "title": "תורם",
  "description": "כרטיס תורם מאוחד למערכת כולל חצות — זהות, קשר, תרומות, שמות לתפילה וקוויטלים.",
  "type": "object",
  "required": ["מזהה_תורם", "סוג_תורם", "זהות"],
  "properties": {
    "מזהה_תורם": { "type": "string", "description": "מזהה פנימי יציב, למשל ת-000123", "pattern": "^ת-\\d{6}$" },
    "סוג_תורם": { "type": "string", "enum": ["יחיד", "עסק", "משק_בית"] },
    "זהות": {
      "type": "object",
      "properties": {
        "שם_פרטי_עברי": { "type": "string", "description": "ממולא ידנית דרך קובץ ההתאמה" },
        "שם_משפחה_עברי": { "type": "string", "description": "ממולא ידנית דרך קובץ ההתאמה" },
        "שם_פרטי_אנגלי": { "type": "string" },
        "שם_משפחה_אנגלי": { "type": "string" },
        "שם_עסק": { "type": "string", "description": "לתרומות שמגיעות מהעסק" },
        "שם_לתצוגה": { "type": "string" }
      },
      "additionalProperties": false
    },
    "פרטי_קשר": {
      "type": "object",
      "properties": {
        "טלפונים": {
          "type": "array",
          "items": {
            "type": "object", "required": ["ערך"],
            "properties": {
              "ערך": { "type": "string" },
              "סוג": { "type": "string", "enum": ["נייד", "בית", "עבודה", "אחר"] },
              "וואטסאפ": { "type": "boolean" },
              "מקור": { "type": "string" }
            },
            "additionalProperties": false
          }
        },
        "אימיילים": {
          "type": "array",
          "items": {
            "type": "object", "required": ["ערך"],
            "properties": {
              "ערך": { "type": "string", "format": "email" },
              "סוג": { "type": "string", "enum": ["אישי", "עבודה", "אחר"] },
              "מקור": { "type": "string" }
            },
            "additionalProperties": false
          }
        },
        "כתובת": { "type": "string" },
        "ערוץ_מועדף": { "type": "string", "enum": ["טלפון", "מייל", "וואטסאפ"] }
      },
      "additionalProperties": false
    },
    "תאריכים": {
      "type": "object",
      "properties": {
        "יום_הולדת_עברי": { "type": "string" },
        "יום_הולדת_לועזי": { "type": "string", "format": "date" },
        "יארצייטים": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": { "שם": { "type": "string" }, "תאריך_עברי": { "type": "string" } },
            "additionalProperties": false
          }
        },
        "תאריכי_תרומה_מועדפים": {
          "type": "array",
          "description": "תאריכים שהתורם רגיל לתרום בהם (מרשימת הוורד השנתית)",
          "items": { "type": "string" }
        }
      },
      "additionalProperties": false
    },
    "דרגת_קוויטל": {
      "type": "string",
      "description": "דרגת התפילה שהתורם משתייך אליה כברירת מחדל",
      "enum": ["יששכר_זבולון", "קוויטל_101", "קוויטל_כללי", "חד_פעמי"]
    },
    "תוויות_קוויטל": {
      "type": "array",
      "description": "תוויות כמו באנשי הקשר של גוגל תחת 'קוויטל'",
      "items": { "type": "string" }
    },
    "גישת_תורם": {
      "type": "object",
      "description": "כניסה עצמאית של התורם לעריכת שמות הקוויטל שלו (הסיסמה נשמרת במערכת ההזדהות, לא כאן)",
      "properties": {
        "שם_משתמש": { "type": "string" },
        "מופעל": { "type": "boolean" },
        "הרשאות": { "type": "array", "items": { "type": "string", "enum": ["עריכת_שמות_קוויטל", "צפייה_בתרומות"] } }
      },
      "additionalProperties": false
    },
    "תרומות": { "type": "array", "items": { "$ref": "#/$defs/תרומה" } },
    "הקדשות": { "type": "array", "items": { "$ref": "#/$defs/הקדשה" } },
    "שמות_לתפילה": { "type": "array", "items": { "$ref": "#/$defs/שם_לתפילה" } },
    "אינטראקציות": { "type": "array", "items": { "$ref": "#/$defs/אינטראקציה" } },
    "תזכורות": { "type": "array", "items": { "$ref": "#/$defs/תזכורת" } },
    "מקורות": { "type": "array", "items": { "$ref": "#/$defs/מקור" } },
    "תגיות": { "type": "array", "items": { "type": "string" } },
    "הערות": { "type": "string" },
    "נוצר_בתאריך": { "type": "string", "format": "date-time" },
    "עודכן_בתאריך": { "type": "string", "format": "date-time" }
  },
  "additionalProperties": false,
  "$defs": {
    "תרומה": {
      "type": "object",
      "required": ["מזהה_תרומה", "תאריך", "סכום", "ערוץ"],
      "properties": {
        "מזהה_תרומה": { "type": "string" },
        "מזהה_תורם": { "type": "string" },
        "תאריך": { "type": "string", "format": "date" },
        "סכום": { "type": "number" },
        "מטבע": { "type": "string", "default": "USD" },
        "ערוץ": {
          "type": "string",
          "description": "מאיפה הכסף הגיע",
          "enum": ["אתר", "נדרים_פלוס", "בנק_ווסט", "אותורייז", "פידליטי", "OJC", "דונורס_פאנד", "וואטסאפ", "גימייל", "צ'ק", "מזומן", "העברה_בנקאית", "זל", "פייפאל", "אחר"]
        },
        "סוג_תרומה": {
          "type": "string",
          "enum": ["שותפות_יששכר_זבולון", "שותפות_חודשית", "פרנס_יום", "פרנס_המאור_שבועי", "פרנס_חדר_קפה_שבועי", "פרנס_חדר_קפה_יומי", "ארוחות_בוקר", "לימוד_לילה_לזכות", "תרומה_לחגים", "בניין_והקדשות", "מנין_בן", "מנין_101", "כולל_חצות_כללי", "חד_פעמי", "אחר"]
        },
        "תדירות": { "type": "string", "enum": ["חד_פעמי", "יומי", "שבועי", "חודשי", "שנתי"] },
        "ייעוד": { "type": "string", "description": "למה נועדה התרומה" },
        "בשם": { "type": "string", "enum": ["אדם", "עסק"] },
        "מזהה_חיצוני": { "type": "string", "description": "מזהה עסקה במקור — למניעת כפילויות" },
        "מקור": { "type": "string" },
        "גולמי": { "type": "object" }
      },
      "additionalProperties": false
    },
    "הקדשה": {
      "type": "object",
      "description": "הקדשה / הנצחה — תרומה לבניין, מקווה או פריט מוקדש (חדר, שולחן וכו')",
      "required": ["מזהה_הקדשה"],
      "properties": {
        "מזהה_הקדשה": { "type": "string" },
        "מזהה_תורם": { "type": "string" },
        "מזהה_תרומה": { "type": "string", "description": "קישור לתרומה הכספית" },
        "פרויקט": { "type": "string", "enum": ["בניין_בית_כנסת", "מקווה", "אחר"] },
        "פריט": { "type": "string", "description": "מה הוקדש — חדר / שולחן / ספסל / מוצר וכו'" },
        "סכום": { "type": "number" },
        "מטבע": { "type": "string", "default": "USD" },
        "סוג_הנצחה": { "type": "string", "enum": ["לזכר", "לזכות", "לרפואת", "אחר"] },
        "נוסח_הנצחה": { "type": "string", "description": "הנוסח המדויק שהתורם ביקש להנציח" },
        "תאריך": { "type": "string", "format": "date" },
        "מקור": { "type": "string" }
      },
      "additionalProperties": false
    },
    "שם_לתפילה": {
      "type": "object",
      "required": ["מזהה_שם", "שמות"],
      "properties": {
        "מזהה_שם": { "type": "string" },
        "מזהה_תורם": { "type": "string" },
        "מזהה_תרומה": { "type": "string", "description": "התרומה שבעקבותיה נמסר השם" },
        "שמות": { "type": "array", "items": { "type": "string" }, "description": "למשל 'פלוני בן פלונית'" },
        "בקשה": { "type": "string", "description": "רפואה / זיווג / זרע של קיימא / פרנסה / ישועה..." },
        "דרגת_תפילה": { "type": "string", "enum": ["יששכר_זבולון", "קוויטל_101", "קוויטל_כללי", "חד_פעמי"] },
        "תוויות_קוויטל": { "type": "array", "items": { "type": "string" } },
        "נכנס_בתאריך": { "type": "string", "format": "date" },
        "פעיל_עד": { "type": "string", "format": "date", "description": "לחד-פעמי — עד מתי בקוויטל" },
        "מקור": { "type": "string" }
      },
      "additionalProperties": false
    },
    "אינטראקציה": {
      "type": "object",
      "required": ["מזהה_אינטראקציה", "חותמת_זמן", "ערוץ"],
      "properties": {
        "מזהה_אינטראקציה": { "type": "string" },
        "מזהה_תורם": { "type": "string" },
        "חותמת_זמן": { "type": "string", "format": "date-time", "description": "מתי היה הקשר" },
        "ערוץ": { "type": "string", "enum": ["טלפון", "מייל", "וואטסאפ", "פנים_אל_פנים", "סמס"] },
        "כיוון": { "type": "string", "enum": ["נכנס", "יוצא"] },
        "תמצית": { "type": "string", "description": "מה נדון" },
        "מזהה_חיצוני": { "type": "string" },
        "מקור": { "type": "string" }
      },
      "additionalProperties": false
    },
    "תזכורת": {
      "type": "object",
      "required": ["מזהה_תזכורת", "נושא"],
      "properties": {
        "מזהה_תזכורת": { "type": "string" },
        "מזהה_תורם": { "type": "string" },
        "נושא": { "type": "string", "description": "לחזור אליו / יום הולדת / תאריך תרומה קבוע" },
        "תאריך_יעד": { "type": "string", "format": "date" },
        "בוצע": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "מקור": {
      "type": "object",
      "required": ["מערכת", "מזהה_במקור"],
      "properties": {
        "מערכת": { "type": "string", "enum": ["אקסל_תורמים", "גוגל_קונטקטס", "רשימת_וורד", "וואטסאפ", "גימייל", "אתר", "ידני", "אברכים"] },
        "מזהה_במקור": { "type": "string" },
        "הותאם_לפי": { "type": "string", "enum": ["שם_עברי_ידני", "אימייל", "טלפון", "שם_מדויק"] },
        "רמת_ביטחון": { "type": "string", "enum": ["מאושר", "סביר", "לא_מאומת"] },
        "קושר_בתאריך": { "type": "string", "format": "date-time" }
      },
      "additionalProperties": false
    }
  }
}
